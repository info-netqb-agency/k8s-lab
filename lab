#!/usr/bin/env bash
# Sudo-free, make-free task runner. Usage: ./lab <target>
# Provides the exact same targets as the Makefile for machines without `make`.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
target="${1:-help}"

case "${target}" in
  install-tools)  bash "${HERE}/scripts/install-tools.sh" ;;
  up)             bash "${HERE}/scripts/up.sh" ;;
  down)           bash "${HERE}/scripts/down.sh" ;;
  stop)           bash "${HERE}/scripts/stop.sh" ;;
  start)          bash "${HERE}/scripts/start.sh" ;;
  reset)          bash "${HERE}/scripts/reset.sh" ;;
  status)         bash "${HERE}/scripts/status.sh" ;;
  ingress)        bash "${HERE}/scripts/ingress.sh" ;;
  metrics)        bash "${HERE}/scripts/metrics.sh" ;;
  deploy-hello)   bash "${HERE}/scripts/deploy-hello.sh" ;;
  undeploy-hello) bash "${HERE}/scripts/undeploy-hello.sh" ;;
  dashboard)          bash "${HERE}/scripts/dashboard.sh" ;;
  dashboard-token)    bash "${HERE}/scripts/dashboard-token.sh" ;;
  undeploy-dashboard) bash "${HERE}/scripts/undeploy-dashboard.sh" ;;
  ai-up)          bash "${HERE}/scripts/ai.sh" up ;;
  ai-down)        bash "${HERE}/scripts/ai.sh" down ;;
  ai-pull)        bash "${HERE}/scripts/ai.sh" pull "${2:-}" ;;
  ai-status)      bash "${HERE}/scripts/ai.sh" status ;;
  ai-logs)        bash "${HERE}/scripts/ai.sh" logs ;;
  versions)       bash -c "source '${HERE}/scripts/lib.sh'; print_versions" ;;
  help|-h|--help|*)
    cat <<'EOF'
k8s-lab — run: ./lab <target>
  install-tools    install kind/helm/kubectl if missing + print versions
  up               create the 4-node kind cluster
  down             delete the cluster
  stop             stop the cluster's nodes without deleting (state kept)
  start            start a previously stopped cluster
  reset            down then up
  status           nodes -o wide + pods -A
  ingress          install ingress-nginx and wait until ready
  metrics          install metrics-server (kubectl top + Headlamp graphs)
  deploy-hello     deploy the hello Helm chart
  undeploy-hello   remove the hello Helm chart
  dashboard        install Headlamp web UI at dashboard.localhost + print token
  dashboard-token  print a fresh 24h Headlamp login token
  undeploy-dashboard  remove the Headlamp web UI
  ai-up            start local AI (Ollama + Open WebUI, GPU) at localhost:3000
  ai-down          stop the local AI stack (models kept)
  ai-pull [MODEL]  pull an Ollama model (default llama3.2:3b)
  ai-status        AI containers + models + GPU usage
  ai-logs          tail the AI stack logs
  versions         print installed tool versions
EOF
    ;;
esac
