# --- Tool binaries -----------------------------------------------------------
# kind/helm/kubectl install to ~/.local/bin, never into the repo. If you ever
# drop binaries here, keep them out of version control:
/bin/
/.local/

# --- Kube / Helm local state -------------------------------------------------
kubeconfig
*.kubeconfig
charts/**/charts/          # fetched chart dependencies
charts/**/*.tgz            # packaged charts

# --- Editor / OS cruft -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs & scratch ----------------------------------------------------------
*.log
tmp/
scratch/

# --- Terraform ---------------------------------------------------------------
# State and variable files (may hold secrets). .terraform.lock.hcl IS committed.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
